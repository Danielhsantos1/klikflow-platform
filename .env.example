# Supabase project URL and public anon key.
# Safe to expose to the browser (NEXT_PUBLIC_*), but still keep this file
# out of version control with real values — only .env.example is committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-only — never prefix with NEXT_PUBLIC_, never
# import it from a "use client" module, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
