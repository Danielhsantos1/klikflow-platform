# Plain HTTPS Neon database URL (no credentials, no query params).
# Safe to expose to the browser (NEXT_PUBLIC_*) — the Data API and Neon
# Auth URLs are both derived from it. Keep this file out of version
# control with real values — only .env.example is committed.
# Example: https://ep-example.c-2.us-east-1.aws.neon.tech/neondb
NEXT_PUBLIC_NEON_DATABASE_URL=

# Managed Better Auth server URL (Neon Console → Auth → Configuration).
NEON_AUTH_BASE_URL=

# Secret for signing session cookies (32+ characters).
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Full Postgres connection string (owner role, has BYPASSRLS).
# Server-only — never prefix with NEXT_PUBLIC_, never import it from a
# "use client" module, never send it to the browser. Used only by
# src/lib/db/admin.ts for trusted server-side operations.
DATABASE_URL=
